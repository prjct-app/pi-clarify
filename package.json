{
  "name": "@prjct.app/pi-clarify",
  "version": "0.1.2",
  "description": "Interactive clarification panel for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "ai-coding",
    "developer-tools",
    "clarification",
    "questions"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-clarify/main/docs/cover-v2.png"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-clarify.git"
  },
  "bugs": {
    "url": "https://github.com/prjct-app/pi-clarify/issues"
  },
  "homepage": "https://github.com/prjct-app/pi-clarify#readme",
  "files": [
    "README.md",
    "index.ts",
    "panel.ts",
    "questions.ts",
    "LICENSE",
    "docs/cover.png",
    "docs/cover-v2.png"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build:pi": "node scripts/build-pi.mjs",
    "audit:runtime": "node scripts/audit-production.mjs"
  },
  "dependencies": {
    "@prjct.app/pi-tui-kit": "^0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "esbuild": "^0.28.1",
    "typebox": "1.3.7"
  }
}
